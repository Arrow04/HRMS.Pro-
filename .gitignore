**/.env.local
**/.env.development
**/.env.production
**/.env.prod

# IDE / Editor
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Expo
hrms_mobile/.expo/
hrms_mobile/.expo-shared/

# Python
*.egg-info/
.pytest_cache/

# Uploads - NEVER commit user files
hrms_backend/uploads/
hrms_backend/routers/uploads/
**/uploads/

# Generated files
hrms_backend/generated/
**/generated/

# Database files
*.db
*.sqlite3
**/*.db
**/*.sqlite3
**/chroma_db/

# Backup files
*.bak
*.bak_*
**/*.bak
**/*.bak_*

