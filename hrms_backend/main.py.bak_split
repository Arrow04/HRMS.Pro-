@app.post("/api/payroll/generate", tags=["Payroll"])
def generate_payroll_endpoint(
    employeeId: int,
    month: int,
    year: int,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    """Calculate and persist a payroll record for one employee."""
    emp = db.query(Employee).filter(Employee.deleted_at.is_(None), Employee.id == employeeId).first()
    if not emp:
        raise HTTPException(status_code=404, detail="Employee not found")
    existing = db.query(Payroll).filter(Payroll.deleted_at.is_(None), 
        Payroll.employee_id == employeeId,
        Payroll.month == month,
        Payroll.year == year,
    ).first()
    if existing:
        raise HTTPException(status_code=409, detail="Payroll already exists for this employee/period")
    payroll = generate_payroll_record(db, emp, month, year)
    return {"message": "Payroll generated", "payrollId": payroll.id, "netSalary": payroll.net_salary}


@app.post("/api/payroll/generate-all", tags=["Payroll"])
def generate_all_payroll(
    month: int,
    year: int,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    """Generate payroll for ALL active employees in the organization."""
    query = db.query(Employee).filter(Employee.deleted_at.is_(None), Employee.status == "active")
    if current_user.organization_id:
        query = query.filter(Employee.organization_id == current_user.organization_id)
    employees = query.all()
    generated = []
    skipped = []
    for emp in employees:
        existing = db.query(Payroll).filter(Payroll.deleted_at.is_(None), 
            Payroll.employee_id == emp.id,
            Payroll.month == month,
            Payroll.year == year,
        ).first()
        if existing:
            skipped.append({"employeeId": emp.id, "name": f"{emp.first_name} {emp.last_name}", "reason": "Already exists"})
            continue
        try:
            pr = generate_payroll_record(db, emp, month, year)
            generated.append({"employeeId": emp.id, "name": f"{emp.first_name} {emp.last_name}", "netSalary": pr.net_salary})
        except Exception as e:
            logger.exception(f"Failed to generate payroll for employee {emp.id}")
            skipped.append({"employeeId": emp.id, "name": f"{emp.first_name} {emp.last_name}", "reason": str(e)})
    return {
        "message": f"Generated {len(generated)} payrolls, skipped {len(skipped)}",
        "generated": generated,
        "skipped": skipped,
    }


