@app.get("/api/performance/stats", tags=["Performance"])
def get_performance_stats(
    organizationId: Optional[int] = None,
    year: Optional[int] = None,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    query = db.query(PerformanceReview).filter(PerformanceReview.deleted_at.is_(None))
    if organizationId:
        query = query.filter(PerformanceReview.employee_id.in_(
            db.query(Employee.id).filter(Employee.organization_id == organizationId)
        ))
    if year:
        query = query.filter(PerformanceReview.review_year == year)

    reviews = query.all()
    scores = [r.overall_score for r in reviews if r.overall_score]

    return {
        "totalReviews": len(reviews),
        "averageScore": round(sum(scores) / len(scores), 2) if scores else 0,
        "highestScore": max(scores) if scores else 0,
        "lowestScore": min(scores) if scores else 0,
        "reviewsByStatus": {
            "draft": len([r for r in reviews if r.status == "draft"]),
            "completed": len([r for r in reviews if r.status == "completed"]),
        },
    }


