    payroll_id: int,
    payload: PayrollStatusUpdate,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    pr = db.query(Payroll).filter(Payroll.deleted_at.is_(None), Payroll.id == payroll_id).first()
