@app.post("/api/holidays/sync-attendance", tags=["Holidays"])
def sync_holidays_to_attendance(
    month: int,
    year: int,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    holidays = db.query(Holiday).filter(Holiday.deleted_at.is_(None), func.extract('year', Holiday.date) == year, func.extract('month', Holiday.date) == month, Holiday.organization_id == current_user.organization_id).all()
    created = 0
    for h in holidays:
        holiday_date = h.date.date() if hasattr(h.date, 'date') else dateparser.parse(str(h.date)).date()
        employees = db.query(Employee).filter(Employee.deleted_at.is_(None), Employee.organization_id == current_user.organization_id).all()
        for emp in employees:
            existing = db.query(Attendance).filter(Attendance.deleted_at.is_(None),
                Attendance.employee_id == emp.id,
                func.date(Attendance.date) == holiday_date,
            ).first()
            if not existing:
                att = Attendance(
                    employee_id=emp.id,
                    organization_id=current_user.organization_id,
                    date=datetime.combine(holiday_date, datetime.min.time()),
                    status="holiday",
                    is_holiday=True,
                    holiday_id=h.id,
                    is_manual_entry=True,
                    sync_status="synced",
                )
                db.add(att)
                created += 1
    db.commit()
    return {"message": f"Synced {created} holiday attendance records", "count": created}


@app.put("/api/holidays/{holiday_id}", tags=["Holidays"])
def update_holiday(
    holiday_id: int,
    holiday_data: HolidayCreate,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    h = db.query(Holiday).filter(Holiday.deleted_at.is_(None), Holiday.id == holiday_id).first()
    if not h:
        raise HTTPException(status_code=404, detail="Holiday not found")
    for key, val in holiday_data.model_dump(exclude_unset=True).items():
        setattr(h, key, val)
    db.commit()
    db.refresh(h)
    return h


@app.delete("/api/holidays/{holiday_id}", tags=["Holidays"])
def delete_holiday(
    holiday_id: int,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    h = db.query(Holiday).filter(Holiday.deleted_at.is_(None), Holiday.id == holiday_id).first()
    if not h:
        raise HTTPException(status_code=404, detail="Holiday not found")
    db.delete(h)
    db.commit()
    return {"message": "Holiday deleted"}


@app.get("/api/holidays/export", tags=["Holidays"])
def export_holidays(
    companyId: Optional[int] = None,
    year: Optional[int] = None,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    import csv, io
    query = db.query(Holiday).filter(Holiday.deleted_at.is_(None))
    if companyId:
        query = query.filter(Holiday.company_id == companyId)
    if year:
        query = query.filter(Holiday.year == year)

    output = io.StringIO()
    writer = csv.writer(output)
    writer.writerow(["name", "date", "type", "description", "isPaid"])
    for h in query.all():
        writer.writerow([h.name, h.date, h.type, h.description, h.is_paid])
    output.seek(0)
    return StreamingResponse(
        iter([output.getvalue()]),
        media_type="text/csv",
        headers={"Content-Disposition": "attachment; filename=holidays.csv"},
    )


@app.post("/api/holidays/import", tags=["Holidays"])
async def import_holidays(
    companyId: int,
    year: int,
    file: UploadFile = File(...),
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    import csv, io
    content = await file.read()
    reader = csv.DictReader(io.StringIO(content.decode()))
    count = 0
    for row in reader:
        h = Holiday(
            name=row.get("name"),
            date=row.get("date"),
            type=row.get("type", "public"),
            description=row.get("description", ""),
            company_id=companyId,
            year=year,
            is_paid=row.get("isPaid", "true").lower() == "true",
        )
        db.add(h)
        count += 1
    db.commit()
    return {"message": f"{count} holidays imported", "count": count}


# --- Dashboard ---

@app.get("/api/dashboard/summary", tags=["Dashboard"])
def get_dashboard_summary(
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    org_id = current_user.organization_id
    now = datetime.utcnow()
    today_str = now.strftime("%Y-%m-%d")
    month_start = now.replace(day=1).strftime("%Y-%m-%d")
    last_day = calendar.monthrange(now.year, now.month)[1]
    month_end = f"{now.year}-{now.month:02d}-{last_day}"

    # Base employee query
    emp_q = db.query(Employee).filter(Employee.deleted_at.is_(None))
    if org_id:
        emp_q = emp_q.filter(Employee.organization_id == org_id)

    # --- Employee counts ---
    total_employees = emp_q.count()
    active_employees = emp_q.filter(Employee.status == "active").count()
    male_count = emp_q.filter(Employee.gender == "male").count()
    female_count = emp_q.filter(Employee.gender == "female").count()
    new_hires = emp_q.filter(Employee.join_date >= month_start, Employee.join_date <= month_end).count()
    attritions = emp_q.filter(Employee.termination_date >= month_start, Employee.termination_date <= month_end).count()

    # --- Department distribution ---
    dept_dist = {}
    departments = db.query(Department).filter(Department.deleted_at.is_(None)).all()
    for d in departments:
        count = emp_q.filter(Employee.department_id == d.id).count()
        if count > 0:
            dept_dist[d.name] = count

    # --- Age distribution ---
    age_brackets = {"18-25": 0, "26-35": 0, "36-45": 0, "46-55": 0, "55+": 0}
    today = now.date()
    for emp in emp_q.all():
        if emp.date_of_birth:
            try:
                dob = emp.date_of_birth
                if isinstance(dob, str):
                    dob = dateparser.parse(dob).date()
                age = today.year - dob.year - ((today.month, today.day) < (dob.month, dob.day))
                if age <= 25: age_brackets["18-25"] += 1
                elif age <= 35: age_brackets["26-35"] += 1
                elif age <= 45: age_brackets["36-45"] += 1
                elif age <= 55: age_brackets["46-55"] += 1
                else: age_brackets["55+"] += 1
            except Exception:
                pass

    # --- Today's attendance ---
    att_today = db.query(Attendance).filter(Attendance.deleted_at.is_(None), func.date(Attendance.check_in) == today_str)
    present_today = att_today.filter(Attendance.status == "present").count()
    late_today = att_today.filter(Attendance.is_late == True).count()
    early_departures = att_today.filter(Attendance.is_early_departure == True).count()

    # --- Leave stats ---
    pending_leaves = db.query(LeaveApplication).filter(
        LeaveApplication.deleted_at.is_(None), LeaveApplication.status == "pending"
    ).count()
    leaves_this_month = db.query(LeaveApplication).filter(
        LeaveApplication.deleted_at.is_(None),
        LeaveApplication.created_at >= month_start,
        LeaveApplication.created_at <= month_end,
    ).count()

    # --- Expense stats ---
    pending_expenses = db.query(Expense).filter(Expense.deleted_at.is_(None), Expense.status == "pending").count()
    expense_total = db.query(func.coalesce(func.sum(Expense.amount), 0)).filter(
        Expense.deleted_at.is_(None),
        Expense.expense_date >= month_start,
        Expense.expense_date <= month_end,
    ).scalar()

    # --- Upcoming holidays (next 5) ---
    upcoming_holidays = db.query(Holiday).filter(
        Holiday.deleted_at.is_(None), Holiday.date >= today_str,
    ).order_by(Holiday.date).limit(5).all()

    holidays_list = [
        {"name": h.name, "date": h.date.strftime("%Y-%m-%d") if hasattr(h.date, "strftime") else str(h.date), "type": h.type or "public"}
        for h in upcoming_holidays
    ]

    # --- Performance ---
    avg_rating = db.query(func.avg(PerformanceReview.rating)).filter(
        PerformanceReview.deleted_at.is_(None),
        PerformanceReview.rating.isnot(None)
    ).scalar() or 0

    # --- Monthly trend (last 6 months) ---
    trend = []
    for i in range(5, -1, -1):
        m = now.month - i
        y = now.year
        if m <= 0:
            m += 12
            y -= 1
        start = f"{y}-{m:02d}-01"
        last = calendar.monthrange(y, m)[1]
        end = f"{y}-{m:02d}-{last}"

        att_count = db.query(Attendance).filter(
            Attendance.deleted_at.is_(None),
            Attendance.check_in >= start, Attendance.check_in <= end,
        ).count()
        leave_count = db.query(LeaveApplication).filter(
            LeaveApplication.deleted_at.is_(None),
            LeaveApplication.created_at >= start, LeaveApplication.created_at <= end,
        ).count()
        payroll_total = db.query(func.coalesce(func.sum(Payroll.net_salary), 0)).filter(
            Payroll.deleted_at.is_(None),
            Payroll.month == m, Payroll.year == y,
        ).scalar()
        expense_total_m = db.query(func.coalesce(func.sum(Expense.amount), 0)).filter(
            Expense.deleted_at.is_(None),
            Expense.expense_date >= start, Expense.expense_date <= end,
        ).scalar()
        candidate_count = db.query(Candidate).filter(
            Candidate.deleted_at.is_(None),
            Candidate.applied_date >= start, Candidate.applied_date <= end,
        ).count()

        trend.append({
            "month": m, "year": y, "label": f"{y}-{m:02d}",
            "attendance": att_count, "leaves": leave_count,
            "payroll": round(payroll_total, 2), "expenses": round(expense_total_m, 2),
            "candidates": candidate_count,
        })

    return {
        "employees": {
            "total": total_employees,
            "active": active_employees,
            "male": male_count,
            "female": female_count,
            "newHires": new_hires,
            "attritions": attritions,
        },
        "attendance": {
            "presentToday": present_today,
            "lateToday": late_today,
            "earlyDepartures": early_departures,
        },
        "leaves": {
            "pending": pending_leaves,
            "thisMonth": leaves_this_month,
        },
        "expenses": {
            "pending": pending_expenses,
            "monthTotal": round(expense_total, 2),
        },
        "departmentDistribution": dept_dist,
        "ageDistribution": age_brackets,
        "upcomingHolidays": holidays_list,
        "averagePerformanceRating": round(avg_rating, 2),
        "monthlyTrend": trend,
        "meta": {
            "companies": db.query(Company).filter(Company.deleted_at.is_(None)).count(),
            "departments": len(departments),
        },
    }


@app.get("/api/dashboard/stats", tags=["Dashboard"])
def get_dashboard_stats(
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    org_id = current_user.organization_id

    emp_query = db.query(Employee).filter(Employee.deleted_at.is_(None))
    if org_id:
        emp_query = emp_query.filter(Employee.organization_id == org_id)

    total_employees = emp_query.count()
    active_employees = emp_query.filter(Employee.status == "active").count()

    today = datetime.utcnow().strftime("%Y-%m-%d")
    present_today = db.query(Attendance).filter(
        Attendance.deleted_at.is_(None),
        func.date(Attendance.check_in) == today,
        Attendance.status == "present",
    ).count()

    pending_leaves = db.query(LeaveApplication).filter(
        LeaveApplication.deleted_at.is_(None),
        LeaveApplication.status == "pending"
    ).count()

    pending_expenses = db.query(Expense).filter(
        Expense.deleted_at.is_(None),
        Expense.status == "pending"
    ).count()

    return {
        "totalEmployees": total_employees,
        "activeEmployees": active_employees,
        "presentToday": present_today,
        "pendingLeaves": pending_leaves,
        "pendingExpenses": pending_expenses,
        "departments": db.query(Department).filter(Department.deleted_at.is_(None)).count(),
        "companies": db.query(Company).filter(Company.deleted_at.is_(None)).count(),
    }


# --- Reports ---

@app.get("/api/reports/overview", tags=["Reports"])
def get_reports_overview(
    period: Optional[str] = "month",
    branch: Optional[int] = None,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    org_id = current_user.organization_id
    emp_query = db.query(Employee).filter(Employee.deleted_at.is_(None))
    if org_id:
        emp_query = emp_query.filter(Employee.organization_id == org_id)

    total_employees = emp_query.filter(Employee.deleted_at.is_(None)).count()
    active_employees = emp_query.filter(Employee.status == "active").count()

    now = datetime.utcnow()
    month_start = now.replace(day=1).strftime("%Y-%m-%d")
    next_month = now.month % 12 + 1
    month_end = now.replace(month=next_month, day=1) - timedelta(days=1)
    month_end_str = month_end.strftime("%Y-%m-%d")

    attendance_month = db.query(Attendance).filter(
        Attendance.deleted_at.is_(None),
        Attendance.check_in >= month_start,
        Attendance.check_in <= month_end_str,
    ).count()

    leaves_month = db.query(LeaveApplication).filter(
        LeaveApplication.deleted_at.is_(None),
        LeaveApplication.created_at >= month_start,
        LeaveApplication.created_at <= month_end_str,
    ).count()

    return {
        "totalEmployees": total_employees,
        "activeEmployees": active_employees,
        "attendanceThisMonth": attendance_month,
        "leavesThisMonth": leaves_month,
        "period": period,
    }


