    employeeId: Optional[int] = None,
    organizationId: Optional[int] = None,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    query = db.query(Expense).filter(Expense.deleted_at.is_(None))
    if employeeId:
        query = query.filter(Expense.employee_id == employeeId)
    if organizationId:
        query = query.filter(Expense.organization_id == organizationId)
    elif current_user.organization_id:
        query = query.filter(Expense.organization_id == current_user.organization_id)
    return query.order_by(Expense.created_at.desc()).all()


@app.post("/api/expenses", tags=["Expenses"])
def create_expense(
    expense_data: ExpenseCreate,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    data = convert_camel_to_snake(expense_data.model_dump())
    from datetime import date
    if isinstance(data.get("expense_date"), str):
        data["expense_date"] = date.fromisoformat(data["expense_date"])
    exp = Expense(**data)
    exp.status = "pending"
    db.add(exp)
    db.commit()
    db.refresh(exp)
    return exp


@app.get("/api/expenses/stats", tags=["Expenses"])
def get_expenses_stats(
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    query = db.query(Expense).filter(Expense.deleted_at.is_(None))
    if current_user.organization_id:
        query = query.filter(Expense.organization_id == current_user.organization_id)

    total = db.query(func.coalesce(func.sum(Expense.amount), 0)).select_from(Expense)
    if current_user.organization_id:
        total = total.filter(Expense.organization_id == current_user.organization_id)

    pending = query.filter(Expense.status == "pending").count()
    approved_count = query.filter(Expense.status == "approved").count()
    rejected = query.filter(Expense.status == "rejected").count()

    return {
        "totalAmount": total.scalar() or 0,
        "pending": pending,
        "approved": approved_count,
        "rejected": rejected,
        "totalExpenses": pending + approved_count + rejected,
    }


