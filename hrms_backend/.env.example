# Database Configuration (PostgreSQL)
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hrms_dev
APP_ENV=development
ALLOW_SQLITE_FALLBACK=true
SEED_DEFAULT_USERS=false
RUN_DB_INIT=true
RUN_SCHEMA_SYNC=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5181
LOG_LEVEL=INFO

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Admin User Configuration
ADMIN_EMAIL=admin@hrms.com
ADMIN_PASSWORD=admin123

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Redis Configuration (for caching and sessions)
REDIS_URL=redis://localhost:6379/0

# Email Configuration (Free with Gmail SMTP)
# To enable email verification, set up Gmail with App Password:
# 1. Go to Google Account settings > Security > 2-Step Verification
# 2. Enable 2-Step Verification
# 3. Go to App Passwords > Generate new app password
# 4. Use the app password below
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@hrmspro.com

# Security Configuration
ENABLE_RATE_LIMITING=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60
ENABLE_CORS=true

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=csv,xlsx,pdf,jpg,jpeg,png

# Production Configuration
DEBUG=false
SENTRY_DSN=
ENABLE_AUDIT_LOGGING=true